{
  "name": "spotify-overlay-app",
  "version": "1.1.5",
  "description": "Spotify Overlay App",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@kawarp/core": "^1.2.0",
    "three": "^0.184.0"
  },
  "build": {
    "appId": "com.elvan.spotifylyricsoverlay",
    "productName": "Spotify Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
